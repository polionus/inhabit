{
  "name": "inhabit",
  "private": true,
  "version": "1.0.0",
  "description": "Inhabit — a game that teaches Lean 4 and the dependent type theory beneath it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:mini": "node scripts/verify-mini.ts",
    "verify:lean": "node scripts/verify-lean.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/dejavu-mono": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "marked": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
